<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES"/>
    <!-- لعرض كل التطبيقات المثبتة في القائمة -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>

    <!-- تُستخدم فقط في المسار الاحتياطي (CarPropertyManager القياسي) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED"/>
    <uses-permission android:name="android.car.permission.CAR_ENERGY"/>
    <uses-permission android:name="android.car.permission.CAR_MILEAGE"/>
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN"/>
    <uses-permission android:name="android.car.permission.CAR_INFO"/>
    <uses-permission android:name="android.car.permission.CAR_EXTERIOR_ENVIRONMENT"/>

    <application
        android:label="Car Home"
        android:icon="@android:drawable/ic_menu_compass"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:supportsRtl="true">

        <uses-library android:name="android.car" android:required="false"/>
        <uses-library android:name="autolink.sdk" android:required="false"/>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true"
            android:resumeWhilePausing="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|density|smallestScreenSize|screenLayout">
            <!-- شاشة رئيسية: يظهر خيار «Car Home» عند ضغط زر Home -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.HOME"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- ويمكن فتحه كتطبيق عادي أيضاً -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <receiver android:name=".InstallReceiver" android:exported="false"/>
    </application>
</manifest>
